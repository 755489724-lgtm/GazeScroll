<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Front camera for blink detection. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Keep blink detection alive while Douyin is in the foreground.
         FOREGROUND_SERVICE_CAMERA is required to use the camera FGS type on API 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Android 13+ needs this for the foreground-service notification to show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      v5.30：单眼闭眼调音量走 AudioManager（STREAM_MUSIC）。这是 normal 级权限，
      安装时自动授予、不弹窗，也不需要用户做任何额外操作。
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      v5.62: an optional accelerator, not a requirement.

      It lets the app write `enabled_accessibility_services` itself, so it can
      turn the accessibility service on (and rebind it after a system kill)
      without the user walking through the system settings at all.

      It is a development permission and only obtainable over adb
      (`pm grant ... WRITE_SECURE_SETTINGS`), so every code path that needs it
      checks AccessibilityBootstrap.canWriteSecureSettings() first and falls
      back to the guided manual flow when it is missing.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!--
      v5.62: the optional floating step guide. It is drawn while the user is
      navigating the system settings, and it only ever contains text we wrote —
      no screen content is read. The permission is asked for but never required:
      without it the in-app guide still works, the bubble just does not appear.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      v5.62：降级为「纯加分项」，App 不再向用户索取、也不再展示它的状态。

      v5.62 之前它是前台检测的主路径；实测在 HyperOS 上这个 appop 会被系统直接
      拒绝（`ignore; rejectTime=…`），拿不到任何数据，却让权限清单多出一项要用户
      处理的东西。现在前台检测以无障碍窗口列表为唯一必需来源（见 AppStateManager），
      usage-stats 只在用户**碰巧**给过权限时作为额外信号使用。

      声明保留，是为了那些已经授权过的用户（以及以后想重新授权的用户）不丢功能；
      但代码里没有任何一条路径会因为它缺失而报错或提示。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <!--
      Package visibility (targetSdk 30+). Needed for:
        - Shizuku: status text and "open Shizuku"
        - the paging-target list: without these entries getPackageInfo() throws
          for every one of them and they would all look "not installed".
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.ss.android.ugc.aweme.lite" />
        <package android:name="com.sina.weibo" />
        <package android:name="com.xingin.xhs" />
        <package android:name="tv.danmaku.bili" />
    </queries>

    <application
        android:name=".GazeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GazeScroll">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Owns the CameraX pipeline and the blink detector; type=camera is required on API 34. -->
        <service
            android:name=".GazeCameraService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Fallback gesture injector. Enabled by AccessibilityBootstrap. -->
        <service
            android:name=".GazeAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Shizuku's binder provider. This is how the app receives the Shizuku
          service binder; it is the app's OWN provider (authority <pkg>.shizuku)
          that Shizuku connects back to.

          android:permission is a *protection* on the provider (only holders of
          INTERACT_ACROSS_USERS_FULL may access it); the app itself does not need
          that permission.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
